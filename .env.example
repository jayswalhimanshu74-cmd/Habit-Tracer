# ==================================================
# HabitTracker Production Environment Variables
# ==================================================

# Environment
NODE_ENV=production
PORT=8000

# Database Configuration (PostgreSQL Cloud DB / Neon / Supabase / Vercel Postgres)
# Option 1: Full Connection String (Recommended for cloud hosting)
DATABASE_URL=postgres://username:password@ep-sample-123456.us-east-1.aws.neon.tech/habittracker?sslmode=require

# Option 2: Individual Connection Credentials (Fallback)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=habittracker
DB_PASSWORD=your_secure_password
DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend CORS URL
CLIENT_URL=https://your-habit-tracker-app.vercel.app

# Frontend Build Variables (Used by Vite during client build)
VITE_API_URL=/api
VITE_SOCKET_URL=https://your-habit-tracker-app.vercel.app
